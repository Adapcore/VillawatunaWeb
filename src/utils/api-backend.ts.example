// Example API configuration for connecting to HotelManagement backend
// Copy this file to api-backend.ts and update the API_BASE_URL

// API Base URL - Update this to match your backend URL
const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000';

// Helper function for API calls
async function apiCall<T>(endpoint: string): Promise<T> {
  try {
    const response = await fetch(`${API_BASE_URL}${endpoint}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
      },
    });

    if (!response.ok) {
      throw new Error(`API call failed: ${response.statusText}`);
    }

    return await response.json();
  } catch (error) {
    console.error(`Error calling ${endpoint}:`, error);
    throw error;
  }
}

// Transform backend ItemDto to frontend Room format
function transformRoomCategoryToRoom(item: { Id: number; Name: string }, index: number): Room {
  return {
    id: item.Id,
    name: item.Name,
    price: 0, // You'll need to add price to your backend model
    image: '', // You'll need to add image URL to your backend model
    rating: 4.5, // Default or from backend
    description: '', // You'll need to add description to your backend model
    images: [],
    accessories: [],
    facilities: [],
  };
}

// API Functions
export async function fetchRooms() {
  try {
    const data = await apiCall<{ Id: number; Name: string }[]>('/api/Room/GetRoomCategories');
    
    // Transform backend data to frontend format
    const rooms = data.map((item, index) => transformRoomCategoryToRoom(item, index));
    
    return { rooms };
  } catch (error) {
    console.error('Error fetching rooms:', error);
    return { rooms: [] };
  }
}

export async function fetchMenu() {
  try {
    const data = await apiCall<any[]>('/api/Menu/getItems');
    
    // Transform backend data to match MenuCategory interface
    // You'll need to adjust this based on your actual API response structure
    return { categories: data };
  } catch (error) {
    console.error('Error fetching menu:', error);
    return { categories: [] };
  }
}

